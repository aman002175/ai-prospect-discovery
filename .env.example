# ==============================================================================
# AI-Powered Multi-Platform Prospect Discovery API - Environment Configuration
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Optional - Free tier available at https://aistudio.google.com)
# If omitted, the service automatically falls back to deterministic rule-based NLP parsing.
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Optional - 1,000 free searches/month at https://tavily.com, no credit card needed)
# If omitted, the service automatically falls back to DuckDuckGo HTML -> DDG Lite -> Bing HTML.
TAVILY_API_KEY=your_tavily_api_key_here

# Web Server Settings
PORT=4000
HOST=0.0.0.0

# Outbound HTTP Request Timeout (seconds)
REQUEST_TIMEOUT=10.0
